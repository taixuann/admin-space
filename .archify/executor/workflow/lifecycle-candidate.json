{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Executor task run",
    "locale": "en",
    "output": "docs/profiles/executor/executor-workflow.html",
    "quality_profile": "showcase"
  },
  "mainPath": [
    "received",
    "executing",
    "verified",
    "reported",
    "done"
  ],
  "states": [
    {
      "id": "received",
      "type": "start",
      "label": "Received",
      "sublabel": "kanban card",
      "tag": "plan path",
      "step": "01"
    },
    {
      "id": "executing",
      "type": "active",
      "label": "Executing",
      "sublabel": "opencode run",
      "tag": "plan branch",
      "step": "02"
    },
    {
      "id": "verified",
      "type": "decision",
      "label": "Verified",
      "sublabel": "checks run",
      "tag": "pass",
      "step": "03"
    },
    {
      "id": "reported",
      "type": "waiting",
      "label": "Reported",
      "sublabel": "report + card",
      "tag": "Tai",
      "step": "04"
    },
    {
      "id": "done",
      "type": "success",
      "label": "Done",
      "sublabel": "card done",
      "tag": "merged",
      "step": "05"
    },
    {
      "id": "blocked",
      "type": "waiting",
      "label": "Blocked",
      "sublabel": "card blocked",
      "tag": "reason set"
    },
    {
      "id": "subtasks",
      "type": "active",
      "label": "Subtasks",
      "sublabel": "subagent-driven",
      "tag": "optional"
    },
    {
      "id": "debugging",
      "type": "active",
      "label": "Debugging",
      "sublabel": "systematic",
      "tag": "root cause"
    },
    {
      "id": "feedback",
      "type": "waiting",
      "label": "Review feedback",
      "sublabel": "receiving-review",
      "tag": "changes"
    }
  ],
  "transitions": [
    {
      "id": "received-executing",
      "from": "received",
      "to": "executing",
      "label": "valid"
    },
    {
      "id": "executing-verified",
      "from": "executing",
      "to": "verified",
      "label": "built"
    },
    {
      "id": "verified-reported",
      "from": "verified",
      "to": "reported",
      "label": "pass"
    },
    {
      "id": "reported-done",
      "from": "reported",
      "to": "done",
      "label": "accepted"
    },
    {
      "id": "received-blocked",
      "from": "received",
      "to": "blocked",
      "label": "invalid",
      "variant": "security"
    },
    {
      "id": "blocked-received",
      "from": "blocked",
      "to": "received",
      "label": "fixed"
    },
    {
      "id": "executing-subtasks",
      "from": "executing",
      "to": "subtasks",
      "label": "split"
    },
    {
      "id": "subtasks-executing",
      "from": "subtasks",
      "to": "executing",
      "label": "joined"
    },
    {
      "id": "verified-debugging",
      "from": "verified",
      "to": "debugging",
      "label": "fail"
    },
    {
      "id": "debugging-executing",
      "from": "debugging",
      "to": "executing",
      "label": "fixed"
    },
    {
      "id": "reported-feedback",
      "from": "reported",
      "to": "feedback",
      "label": "review"
    },
    {
      "id": "feedback-executing",
      "from": "feedback",
      "to": "executing",
      "label": "changes"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Kanban card (input)",
      "items": [
        "Assigned to executor by any authorized profile; it carries the plan path in the owning Space.",
        "Plan header: requester, space, base, branch, scope, checks, engine, report. A missing field blocks the card.",
        "Scope is the requester's own authority, never more."
      ]
    },
    {
      "dot": "amber",
      "title": "Methods",
      "items": [
        "Executing: superpowers:executing-plans, with the opencode skill run in the requester's Space when engine is opencode.",
        "Engine self: small doc or config edits Executor makes directly.",
        "Subtasks: subagent-driven-development only for independent subtasks.",
        "Debugging: systematic-debugging. Verified: verification-before-completion before report.",
        "Review feedback: receiving-code-review."
      ]
    },
    {
      "dot": "violet",
      "title": "Card states and commits",
      "items": [
        "Executing works on the plan's task branch and commits there; the report and card carry the result.",
        "Blocked: missing or ambiguous plan, missing header field, no authority, or dirty tree; the card states the reason.",
        "Reported waits for Tai's review; Done means Tai accepted and the branch is merged.",
        "Never overwrite someone else's uncommitted work."
      ]
    },
    {
      "dot": "rose",
      "title": "Limits",
      "items": [
        "Push, publish, external sharing: Tai approval only.",
        "Merge to base: Tai approval only.",
        "Hermes runtime config: only with Tai's approval and a rollback step in the plan.",
        "Never writes credentials or raw research data.",
        "Model is set by Tai and managed by the runtime (claude-haiku-5-5 / anthropic), with no fallback."
      ]
    }
  ]
}
