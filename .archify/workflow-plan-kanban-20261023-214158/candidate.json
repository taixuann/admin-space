  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership",
      "items": [
        "Superpowers owns task execution and native review.",
        "Codex / Claude reads results and updates Kanban; it does not review code.",
        "The patch validator is the only machine card writer."
      ]
    },
    {
      "dot": "amber",
      "title": "Recovery and authority",
      "items": [
        "A card move is not launch authorization. One active writer per workspace.",
        "A crash or missing evidence stays unknown; retry publication without rerunning work.",
        "Notion inbound changes become validated requests, not direct execution commands."
      ]
    },
    {
      "dot": "violet",
      "title": "Scope",
      "items": [
        "Target workflow only; no automation is installed or activated by this diagram.",
        "Stable evidence survives scratch cleanup. Memory is context, not job state.",
        "Notion sync and inbound control need separate implementation designs."
      ]
    }
