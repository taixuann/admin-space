{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Secretary - one profile-management workflow",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "docs/profiles/secretary/secretary-workflow.html"
  },
  "lanes": [
    {
      "id": "taiAuthority",
      "label": "Tai authority"
    },
    {
      "id": "secretary",
      "label": "Secretary"
    },
    {
      "id": "policyMethods",
      "label": "Policy and methods"
    },
    {
      "id": "executorDraft",
      "label": "Executor proposed"
    },
    {
      "id": "application",
      "label": "Authorized application"
    },
    {
      "id": "coordinatorOptional",
      "label": "Coordinator optional"
    }
  ],
  "nodes": [
    {
      "id": "taiRequest",
      "lane": "taiAuthority",
      "col": 0,
      "type": "external",
      "label": "Tai request",
      "sublabel": "Profile change request"
    },
    {
      "id": "secReceive",
      "lane": "secretary",
      "col": 0,
      "type": "backend",
      "label": "Secretary receives",
      "sublabel": "Intake and supervision"
    },
    {
      "id": "scopeRequest",
      "lane": "secretary",
      "col": 1,
      "type": "backend",
      "label": "Scope request",
      "sublabel": "Self / another profile",
      "tag": "Create / update / maintain / delete"
    },
    {
      "id": "policyMethod",
      "lane": "policyMethods",
      "col": 2,
      "type": "backend",
      "label": "Policy + method",
      "sublabel": "hermes-fleet-admin + specialists"
    },
    {
      "id": "approveScope",
      "lane": "taiAuthority",
      "col": 3,
      "type": "security",
      "label": "Approve scope",
      "sublabel": "Exact scoped brief for writes"
    },
    {
      "id": "prepareTest",
      "lane": "executorDraft",
      "col": 3,
      "type": "backend",
      "label": "Prepare + test",
      "sublabel": "Verified sandbox only",
      "tag": "draft; block if no isolation"
    },
    {
      "id": "reviewEvidence",
      "lane": "secretary",
      "col": 4,
      "type": "backend",
      "label": "Review evidence",
      "sublabel": "Tests vs acceptance"
    },
    {
      "id": "authorizedApply",
      "lane": "application",
      "col": 4,
      "type": "security",
      "label": "Authorized apply",
      "sublabel": "Separately authorized operator",
      "tag": "runtime: approval + backup"
    },
    {
      "id": "verify",
      "lane": "secretary",
      "col": 5,
      "type": "backend",
      "label": "Verify",
      "sublabel": "Scoped checks + evidence"
    },
    {
      "id": "reportStop",
      "lane": "taiAuthority",
      "col": 5,
      "type": "external",
      "label": "Report / stop",
      "sublabel": "Pass / blocked / untested"
    },
    {
      "id": "coordinator",
      "lane": "coordinatorOptional",
      "col": 1,
      "type": "external",
      "label": "Coordinator",
      "sublabel": "Optional facts",
      "tag": "optional"
    }
  ],
  "edges": [
    {
      "from": "taiRequest",
      "to": "secReceive",
      "label": "request",
      "role": "main"
    },
    {
      "from": "secReceive",
      "to": "scopeRequest",
      "label": "intake",
      "role": "main"
    },
    {
      "from": "scopeRequest",
      "to": "policyMethod",
      "label": "scope",
      "role": "main"
    },
    {
      "from": "policyMethod",
      "to": "approveScope",
      "label": "write work",
      "role": "main",
      "variant": "security"
    },
    {
      "from": "approveScope",
      "to": "prepareTest",
      "label": "approved scope",
      "role": "main",
      "variant": "security"
    },
    {
      "from": "prepareTest",
      "to": "reviewEvidence",
      "label": "patch/tests",
      "role": "main"
    },
    {
      "from": "reviewEvidence",
      "to": "authorizedApply",
      "label": "accepted + authorized",
      "role": "main",
      "variant": "security"
    },
    {
      "from": "authorizedApply",
      "to": "verify",
      "label": "apply",
      "role": "main"
    },
    {
      "from": "verify",
      "to": "reportStop",
      "label": "result",
      "role": "main"
    },
    {
      "from": "policyMethod",
      "to": "verify",
      "label": "read-only",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "scopeRequest",
      "to": "reportStop",
      "label": "scope missing",
      "role": "error"
    },
    {
      "from": "scopeRequest",
      "to": "coordinator",
      "label": "need facts; authorized",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "coordinator",
      "to": "policyMethod",
      "label": "facts/pointers",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Target + operation",
      "items": [
        "Self or other profile: same rules",
        "Create, update, maintain, delete",
        "SOUL, skills, plugins, MCPs, tools",
        "Automation, memory, permissions, workflows",
        "No separate brainstorm/plan/skill worktypes"
      ]
    },
    {
      "dot": "violet",
      "title": "Roles + methods",
      "items": [
        "Secretary accountable",
        "hermes-fleet-admin lifecycle coordinator",
        "hermes-agent native guidance",
        "documentation-writer / writing-for-agents",
        "archify views",
        "Inspect, Define, Review, Configure, Verify, Reconcile",
        "Actions are individually selectable; planning/skill writing are support methods, not extra work types."
      ]
    },
    {
      "dot": "amber",
      "title": "Trust + status",
      "items": [
        "Executor is draft; sandbox-tested separately",
        "No self-expanded permissions",
        "Models follow approved task/runtime settings",
        "Sensitive live, identity, destructive changes need Tai approval",
        "Coordinator provides facts only",
        "Executor returns patches/artifacts and tests; it never applies live changes.",
        "Before runtime writes: approved delta, recoverable backup and rollback. Then readback and relevant live check.",
        "Delete: explicit destructive confirmation, dependency checks and recoverable backup.",
        "This is the intended workflow, not deployment. Current execution setup is unchanged."
      ]
    }
  ],
  "semanticChecks": {
    "allowedRoots": [
      "taiRequest"
    ],
    "allowedTerminals": [
      "reportStop"
    ],
    "requiredEdges": [
      {
        "from": "prepareTest",
        "to": "reviewEvidence"
      },
      {
        "from": "reviewEvidence",
        "to": "authorizedApply"
      },
      {
        "from": "authorizedApply",
        "to": "verify"
      }
    ],
    "requiredPaths": [
      {
        "from": "taiRequest",
        "to": "reportStop"
      }
    ]
  }
}
