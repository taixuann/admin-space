{
  "model": {
    "primary": "operation.high",
    "fallback": [
      "operation.standard"
    ]
  },
  "dirs": {
    "~/.agents/bots/": "read/write",
    "~/.agents/": "read",
    "~/.hermes/": "read",
    "~/.hermes/profiles/": "read/write"
  },
  "skills": {
    "enable": [
      "hermes-agent",
      "hermes-fleet-admin"
    ],
    "link": {
      "~/.agents/skills": [
        "archify",
        "writing-for-agents",
        "ticket-submit",
        "notion-cli"
      ]
    }
  },
  "plugins": {
    "enable": [
      "bot-forge",
      "quota",
      "superpowers",
      "mnemosyne"
    ]
  },
  "mcps": {
    "enable": [
      "notion"
    ]
  },
  "memory": {
    "provider": "mnemosyne"
  }
}
