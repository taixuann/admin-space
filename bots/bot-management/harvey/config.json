{
  "model": {
    "primary": "operation.high",
    "fallback": [
      "operation.standard"
    ]
  },
  "dirs": {
    "~/.agents/bots/": "read/write",
    "~/.agents/": "read",
    "~/.hermes/": "read",
    "~/.hermes/profiles/": "read/write"
  },
  "skills": {
    "external_dirs": [
      "~/.agents/skills"
    ]
  },
  "plugins": {
    "enable": [
      "bot-forge",
      "caveman_native",
      "caveman_shrink",
      "mnemosyne",
      "quota",
      "superpowers"
    ]
  },
  "mcps": {
    "enable": [
      "notion"
    ]
  },
  "memory": {
    "provider": "mnemosyne"
  }
}
