{
  "model": {
    "primary": "coding.high",
    "fallback": [
      "coding.standard"
    ]
  },
  "dirs": {
    "~/.agents/bots/dev-team/": "read",
    "~/development-space/": "read",
    "~/.agents/docs/superpowers/plans/": "read/write"
  },
  "skills": {
    "external_dirs": [
      "~/.hermes/skills"
    ]
  },
  "plugins": {
    "enable": [
      "caveman_native",
      "caveman_shrink",
      "ponytail",
      "superpowers"
    ]
  },
  "mcps": {
    "enable": [
      "decision-engine"
    ]
  },
  "memory": {
    "provider": "built-in"
  }
}
