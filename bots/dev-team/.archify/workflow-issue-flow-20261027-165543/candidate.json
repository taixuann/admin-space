  "cards": [
    {
      "dot": "cyan",
      "title": "Check issue (Forge)",
      "items": [
        "1. Read the issue with gh: body, comments, labels, linked PRs. An open linked PR means skip",
        "2. Read all other open issues in the repo. Duplicate of a fixed one: close with a link. Two open duplicates: keep one, close the other, link them",
        "3. Brainstorm and audit the code: solved, not solved, or unclear, with evidence",
        "4. Comment the verdict on GitHub. Notion ticket (Human review) holds only the link. Block the card as needs_input"
      ]
    },
    {
      "dot": "cyan",
      "title": "Gate 1: Approved in Notion",
      "items": [
        "Tai opens the link, reads the verdict on GitHub, and sets the ticket to Approved",
        "The cron unblocks the card. Solved: Forge comments and closes the issue. Not solved: planning starts"
      ]
    },
    {
      "dot": "amber",
      "title": "Plan review (Athena)",
      "items": [
        "Forge writes the plan and requests review on the same card",
        "Athena runs audit-writing-plans; opencode is her second pass",
        "Changes return the card to Forge. Two rounds, then blocked"
      ]
    },
    {
      "dot": "amber",
      "title": "Build, then the gate before PR",
      "items": [
        "Forge runs opencode in a worktree on the approved plan; no review in between",
        "Athena runs the checklist, then decision-engine; Forge reviews with requesting-code-review first",
        "Approve: Forge opens the PR with Closes #N. Request changes: back to build. Two attempts, then blocked and a Notion ticket for Tai"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gate 2 and release",
      "items": [
        "Tai reviews the PR and sets the ticket to Done",
        "The cron sees Done. Forge runs the repo's release gate, then CI and merge state, merges, runs github-repo-care to tag and release",
        "Canceled in Notion: the cron comments on the issue, closes the issue and its PR"
      ]
    },
    {
      "dot": "rose",
      "title": "Writes outside the machine",
      "items": [
        "Issue comments, duplicate closes, Notion links, the PR, the merge and the release all leave the machine",
        "Forge merges only after Notion Done",
        "AGENTS.md, CLAUDE.md or SOUL.md edits can hit an approval prompt; the run then stops",
        "decision-engine sends the completed change to an external service (completion only)"
      ]
    }
  ]
