#!/usr/bin/env python3
"""Theme and color authority loader for research studies.

Dynamic, schema-driven visual authority loader that bridges spec reasoning
and plotting scripts without hardcoding colors or arbitrary section names.
"""

from __future__ import annotations

from pathlib import Path
from typing import Any, Dict, Optional
import yaml

EXCLUDED_METADATA_KEYS = {"schema_version", "description", "version", "meta", "metadata"}


def resolve_color_code_path(study_root: Path | None = None) -> Path:
    """Resolve the nearest color-code.yaml authority up the directory hierarchy."""
    if study_root is None:
        study_root = Path(__file__).resolve().parents[2]
    cur = Path(study_root).resolve()

    while cur != cur.parent:
        candidate = cur / "color-code.yaml"
        if candidate.is_file():
            return candidate
        candidate_studies = cur / "studies" / "color-code.yaml"
        if candidate_studies.is_file():
            return candidate_studies
        candidate_docs = cur / "docs" / "color-code.yaml"
        if candidate_docs.is_file():
            return candidate_docs
        cur = cur.parent

    raise FileNotFoundError(f"color-code.yaml authority not found in study hierarchy (study_root={study_root})")


def load_palette_metadata(study_root: Path | None = None) -> Dict[str, Any]:
    """Load the raw color authority dictionary including labels and descriptions."""
    color_file = resolve_color_code_path(study_root)
    with color_file.open(encoding="utf-8") as fh:
        data = yaml.safe_load(fh) or {}
    return data if isinstance(data, dict) else {}


def load_study_colors(study_root: Path | None = None) -> Dict[str, str]:
    """Load universal condition, state, and series colors from color-code.yaml.

    Dynamically extracts color definitions across any section (e.g., binary,
    sequential, categorical, spectral, temperatures, states, or custom names)
    mapping token identifiers (e.g. '10K', 'baseline', 'ito', 'component_gray')
    directly to hex codes.
    """
    raw = load_palette_metadata(study_root)
    palette: Dict[str, str] = {}

    def _extract_colors(node: Any) -> None:
        if isinstance(node, dict):
            for key, val in node.items():
                if str(key).lower() in EXCLUDED_METADATA_KEYS:
                    continue
                if isinstance(val, dict):
                    if "color" in val and isinstance(val["color"], str):
                        palette[str(key)] = val["color"].strip()
                    else:
                        _extract_colors(val)
                elif isinstance(val, list):
                    _extract_colors(val)
                elif isinstance(val, str) and val.strip().startswith("#"):
                    palette[str(key)] = val.strip()
        elif isinstance(node, list):
            for item in node:
                if isinstance(item, dict):
                    role_key = item.get("role") or item.get("name") or item.get("key") or item.get("id")
                    if role_key and "color" in item and isinstance(item["color"], str):
                        palette[str(role_key)] = item["color"].strip()
                    _extract_colors(item)

    _extract_colors(raw)
    return palette


def get_color(token: str, default: str = "#000000", study_root: Path | None = None) -> str:
    """Retrieve the hex color for a given condition/series token, falling back to default."""
    palette = load_study_colors(study_root)
    return palette.get(token, default)
