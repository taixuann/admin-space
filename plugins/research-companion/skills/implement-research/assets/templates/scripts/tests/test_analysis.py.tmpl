#!/usr/bin/env python3
"""Synthetic unit tests for numerical extraction and domain analysis."""

from __future__ import annotations

import unittest
from pathlib import Path

# Adjust path for running test standalone
import sys
SCRIPTS_DIR = Path(__file__).resolve().parents[1]
if str(SCRIPTS_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPTS_DIR))

from specific.analysis import extract_window_metrics, analyze_series_data


class TestDomainAnalysis(unittest.TestCase):
    def test_extract_window_metrics_normal(self):
        t = [0.0, 1.0, 2.0, 3.0, 4.0]
        y = [10.0, 20.0, 30.0, 40.0, 50.0]

        res = extract_window_metrics(t, y, 1.0, 3.0)
        self.assertEqual(res["count"], 3)
        self.assertAlmostEqual(res["mean"], 30.0)
        self.assertAlmostEqual(res["std"], 10.0)

    def test_extract_window_metrics_empty(self):
        t = [0.0, 1.0, 2.0]
        y = [10.0, 20.0, 30.0]

        res = extract_window_metrics(t, y, 5.0, 10.0)
        self.assertEqual(res["count"], 0)
        self.assertTrue(res["mean"] != res["mean"])  # NaN check

    def test_analyze_series_data(self):
        raw = {"object_id": "test_01", "name": "sample_A"}
        res = analyze_series_data(raw, {"param1": 42})
        self.assertEqual(res["status"], "PROCESSED")
        self.assertEqual(res["object_id"], "test_01")


if __name__ == "__main__":
    unittest.main()
