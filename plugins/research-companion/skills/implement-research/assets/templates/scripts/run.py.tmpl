#!/usr/bin/env python3
"""Execute one explicitly selected analysis and seal its immutable run record."""

from __future__ import annotations

import argparse
import hashlib
import importlib
import importlib.metadata
import json
import os
import re
import shutil
import sys
sys.dont_write_bytecode = True
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import yaml


RUN_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def path_inside(root: Path, path: Path, label: str) -> Path:
    resolved_root = root.resolve()
    supplied = path if path.is_absolute() else resolved_root / path
    root_parts = resolved_root.parts
    if supplied.anchor != resolved_root.anchor or supplied.parts[:len(root_parts)] != root_parts:
        raise ValueError(f"{label} must remain inside the selected study: {path}")
    current = resolved_root
    for part in supplied.parts[len(root_parts):]:
        if part == "..":
            current = current.parent
            if current != resolved_root and resolved_root not in current.parents:
                raise ValueError(f"{label} must remain inside the selected study: {path}")
            continue
        current = current / part
        if current.is_symlink():
            raise ValueError(f"Symlinked execution path is not allowed: {current}")
    resolved = supplied.resolve(strict=False)
    if resolved != resolved_root and resolved_root not in resolved.parents:
        raise ValueError(f"{label} must remain inside the selected study: {path}")
    return resolved


def allocate_run_dir(study_root: Path, run_id: str | None = None, out: str | None = None) -> Path:
    """Create a new run directory atomically; never reuse or fill an occupied path."""
    study_root = study_root.resolve()
    runs_root = study_root / "runs"
    if runs_root.is_symlink():
        raise ValueError(f"Symlinked run allocation directory is not allowed: {runs_root}")
    if out:
        candidate = Path(out)
        if not candidate.is_absolute():
            candidate = study_root / candidate
        candidate = candidate.absolute()
        if candidate.is_symlink():
            raise ValueError(f"Symlinked run directory is not allowed: {candidate}")
        if candidate.parent.resolve(strict=False) != runs_root.resolve(strict=False):
            raise ValueError("--out must name one direct child of <study-root>/runs")
        selected_id = candidate.name
    elif run_id:
        selected_id = run_id
        candidate = runs_root / selected_id
    else:
        selected_id = datetime.now(timezone.utc).strftime("%Y-%m-%d-%H%M%S")
        candidate = runs_root / selected_id
    if not RUN_ID_RE.fullmatch(selected_id) or selected_id in {".", ".."}:
        raise ValueError(f"Unsafe run ID: {selected_id!r}")
    if run_id and out and run_id != selected_id:
        raise ValueError("--run-id and --out identify different run directories")
    if runs_root.exists() and not runs_root.is_dir():
        raise ValueError(f"Run allocation parent is not a directory: {runs_root}")
    runs_root.mkdir(parents=True, exist_ok=True)
    candidate.mkdir(parents=False, exist_ok=False)
    return candidate


def spawn_run_dir(study_root: Path, title: str, now: datetime | None = None) -> Path:
    slug = "".join(char if char.isalnum() or char in "-_" else "-" for char in title).strip("-_") or "run"
    stamp = (now or datetime.now(timezone.utc)).astimezone(timezone.utc).strftime("%Y-%m-%d-%H%M%S")
    return allocate_run_dir(study_root, run_id=f"{stamp}_{slug}")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Execute and seal one plan-led research run.")
    parser.add_argument("--study-root", required=True, help="Selected new plan-led analysis folder")
    parser.add_argument("--project-root", required=True, help="Explicit root used for relative input paths")
    parser.add_argument("--plan", required=True, help="Selected analysis plan inside the study folder")
    parser.add_argument("--authorization", required=True, help="Human authorization for this execution")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--run-id", help="Unique run directory name under runs/")
    group.add_argument("--out", help="Unique output directory; must be a direct child of runs/")
    parser.add_argument("--specific", default="analysis", help="specific.<NAME> module exposing run_study_analysis")
    parser.add_argument("--param", action="append", default=[], help="Parameter override key=value (repeatable)")
    parser.add_argument("--params-json", help="JSON file containing parameters to merge")
    parser.add_argument("--title", default="analysis", help="Run title used for generated run IDs")
    parser.add_argument("--preset", help="Study-local FigRecipe preset path")
    return parser.parse_args(argv)


def load_params(args: argparse.Namespace) -> dict[str, Any]:
    raw = os.environ.get("STUDY_PARAMS", "")
    params = json.loads(raw) if raw else {}
    if not isinstance(params, dict):
        raise ValueError("STUDY_PARAMS must contain a JSON object")
    if args.params_json:
        params_path = Path(args.params_json)
        if not params_path.is_file():
            raise FileNotFoundError(f"Parameter file not found: {params_path}")
        added = json.loads(params_path.read_text(encoding="utf-8"))
        if not isinstance(added, dict):
            raise ValueError("--params-json must contain a JSON object")
        params.update(added)
    for item in args.param:
        key, separator, value = item.partition("=")
        if not separator or not key.strip():
            raise ValueError(f"Invalid parameter override: {item}; expected key=value")
        params[key.strip()] = value.strip()
    params["title"] = args.title
    return params


def plan_revision(plan_path: Path) -> int:
    text = plan_path.read_text(encoding="utf-8")
    match = re.search(r'<textarea id="am-source"[^>]*>(.*?)</textarea>', text, re.DOTALL)
    source = match.group(1).strip() if match else text
    frontmatter = re.match(r"^---\s*\n(.*?)\n---", source, re.DOTALL)
    if not frontmatter:
        raise ValueError(f"Selected plan has no YAML front matter: {plan_path}")
    metadata = yaml.safe_load(frontmatter.group(1))
    revision = metadata.get("revision") if isinstance(metadata, dict) else None
    if type(revision) is not int or revision < 1:
        raise ValueError("Selected plan requires a positive integer revision")
    return revision


def tree_hashes(study_root: Path) -> dict[str, str]:
    paths: list[Path] = []
    for relative in ("spec", "plans", "scripts"):
        base = study_root / relative
        if base.is_symlink():
            raise ValueError(f"Symlinked protected directory is not allowed: {base}")
        if base.is_dir():
            for path in base.rglob("*"):
                if path.is_symlink():
                    raise ValueError(f"Symlinked protected file is not allowed: {path}")
                if path.is_file() and "__pycache__" not in path.parts:
                    paths.append(path)
    for relative in ("input.yaml", "color-code.yaml"):
        path = study_root / relative
        if path.is_symlink():
            raise ValueError(f"Symlinked protected file is not allowed: {path}")
        if path.is_file():
            paths.append(path)
    return {path.relative_to(study_root).as_posix(): sha256_file(path) for path in sorted(set(paths))}


def snapshot_file(study_root: Path, run_dir: Path, source: Path, target_rel: str) -> dict[str, str]:
    source = path_inside(study_root, source, "Recovery source")
    if source.is_symlink() or not source.is_file():
        raise ValueError(f"Missing or symlinked recovery source: {source}")
    dest = path_inside(run_dir, run_dir / target_rel, "Recovery snapshot")
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, dest)
    digest = sha256_file(source)
    if sha256_file(dest) != digest:
        raise ValueError(f"Recovery snapshot hash mismatch: {dest}")
    return {"path": source.relative_to(study_root).as_posix(), "sha256": digest,
            "snapshot_path": dest.relative_to(study_root).as_posix()}


def snapshot_code(study_root: Path, run_dir: Path, preset: Path | None) -> list[dict[str, str]]:
    script_root = study_root / "scripts"
    sources = sorted(path for path in script_root.rglob("*.py") if path.is_file() and "__pycache__" not in path.parts)
    if not sources:
        raise ValueError("No executable Python source files found under scripts/")
    if preset is not None:
        preset = path_inside(study_root, preset, "FigRecipe preset")
        if preset not in sources:
            sources.append(preset)
    records = []
    for source in sources:
        source_rel = source.relative_to(study_root).as_posix()
        target_rel = (Path("code") / source_rel).as_posix()
        record = snapshot_file(study_root, run_dir, source, target_rel)
        records.append({"path": record["path"], "sha256": record["sha256"], "snapshot_path": record["snapshot_path"]})
    palette = study_root / "color-code.yaml"
    if palette.is_file():
        palette_record = snapshot_file(study_root, run_dir, palette, "code/color-code.yaml")
        records.append({"path": palette_record["path"], "sha256": palette_record["sha256"], "snapshot_path": palette_record["snapshot_path"]})
    return records


def output_inventory(run_dir: Path) -> list[dict[str, str]]:
    records = []
    excluded = {"run.lock.yaml", "params.json", "plan", "inputs", "code"}
    for path in sorted(run_dir.rglob("*")):
        if path.is_symlink():
            raise ValueError(f"Symlinked output is not allowed: {path}")
        if not path.is_file() or path.relative_to(run_dir).parts[0] in excluded:
            continue
        relative = path.relative_to(run_dir).as_posix()
        if relative.startswith(".") or "/__pycache__/" in relative:
            continue
        role = "figure" if relative.startswith("figures/") else "table" if relative.startswith("tables/") else "log" if relative.startswith("logs/") or relative.endswith(".log") else "analysis-output"
        records.append({"object_id": f"file:{relative}", "role": role, "path": relative, "sha256": sha256_file(path)})
    return records


def validate_required_outputs(run_dir: Path, declared: Any, outputs: list[dict[str, str]]) -> None:
    if not isinstance(declared, list) or not declared:
        if not outputs:
            raise ValueError("Analysis produced no required output files")
        return
    present = {item["path"] for item in outputs}
    for value in declared:
        if not isinstance(value, str) or not value.strip():
            raise ValueError("required_outputs entries must be non-empty relative paths")
        relative = Path(value)
        if relative.is_absolute() or ".." in relative.parts:
            raise ValueError(f"Unsafe required output path: {value}")
        target = run_dir / relative
        if target.is_symlink() or value not in present or not target.is_file():
            raise ValueError(f"Required output is missing: {value}")


def recovery_snapshots_unchanged(
    study_root: Path,
    plan_record: dict[str, Any],
    input_record: dict[str, Any],
    code_records: list[dict[str, str]],
) -> bool:
    for record in (plan_record, input_record, *code_records):
        snapshot = path_inside(study_root, study_root / record["snapshot_path"], "Recovery snapshot")
        if sha256_file(snapshot) != record["sha256"]:
            return False
    return True


def environment_record() -> dict[str, Any]:
    packages = [
        {"name": name, "version": distribution.version}
        for distribution in importlib.metadata.distributions()
        if (name := distribution.metadata.get("Name"))
    ]
    packages.sort(key=lambda item: (item["name"].casefold(), item["name"], item["version"]))
    return {"interpreter": sys.executable, "python": sys.version, "packages": packages}


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    study_root = Path(args.study_root).resolve()
    project_root = Path(args.project_root).resolve()
    if not study_root.is_dir() or not project_root.is_dir():
        print("Selected study-root and project-root must both exist as directories", file=sys.stderr)
        return 2
    runner_path = Path(__file__).absolute()
    scripts_root = (study_root / "scripts").resolve()
    if runner_path.is_symlink() or not runner_path.is_file() or runner_path.resolve().parent != scripts_root:
        print("Execution runner must be located under study_root/scripts so its code is included in the run snapshot", file=sys.stderr)
        return 2
    if not args.authorization.strip():
        print("Human execution authorization is required", file=sys.stderr)
        return 2
    plan_argument = Path(args.plan)
    if not plan_argument.is_absolute():
        plan_argument = study_root / plan_argument
    plan_path = path_inside(study_root, plan_argument, "Selected plan")
    if not plan_path.is_file():
        print(f"Selected plan not found: {plan_path}", file=sys.stderr)
        return 2
    input_manifest_path = study_root / "input.yaml"
    if input_manifest_path.is_symlink() or not input_manifest_path.is_file():
        print(f"input.yaml missing or symlinked: {input_manifest_path}", file=sys.stderr)
        return 2
    try:
        revision = plan_revision(plan_path)
        run_dir = allocate_run_dir(study_root, run_id=args.run_id, out=args.out) if args.run_id or args.out else spawn_run_dir(study_root, args.title)
    except Exception as exc:  # aqg: top-level boundary - preserve the allocation error for the run record
        print(str(exc), file=sys.stderr)
        return 2

    started_at = datetime.now(timezone.utc).isoformat()
    run_id = run_dir.name
    os.environ["STUDY_RUN_DIR"] = str(run_dir)
    os.environ["STUDY_PROJECT_ROOT"] = str(project_root)
    os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
    os.environ.setdefault("MPLCONFIGDIR", str(Path(os.environ.get("TMPDIR", "/tmp")) / f"matplotlib-exec-{os.getpid()}"))

    status = "FAILED"
    exit_code = 1
    error = None
    data: dict[str, Any] | None = None
    params: dict[str, Any] = {}
    plan_record: dict[str, Any] = {"path": plan_path.relative_to(study_root).as_posix(), "revision": revision,
                                   "snapshot_path": f"runs/{run_id}/plan/{plan_path.name}",
                                   "authorization": args.authorization}
    input_record: dict[str, Any] = {"path": "input.yaml", "snapshot_path": f"runs/{run_id}/inputs/input.yaml"}
    code_records: list[dict[str, str]] = []
    before: dict[str, str] = {}
    input_unchanged = False
    protected_unchanged = False
    required_outputs_valid = False
    analyzed: Any = {}
    interrupt: KeyboardInterrupt | None = None
    try:
        plan_record["sha256"] = sha256_file(plan_path)
        input_record["sha256"] = sha256_file(input_manifest_path)
        before = tree_hashes(study_root)
        plan_snapshot = snapshot_file(study_root, run_dir, plan_path, f"plan/{plan_path.name}")
        input_snapshot = snapshot_file(study_root, run_dir, input_manifest_path, "inputs/input.yaml")
        if plan_snapshot["sha256"] != plan_record["sha256"] or input_snapshot["sha256"] != input_record["sha256"]:
            raise ValueError("Plan or input manifest changed during recovery snapshot")
        preset = None
        if args.preset:
            from modules.plot import resolve_preset_path
            preset = path_inside(study_root, resolve_preset_path(args.preset, study_root), "FigRecipe preset")
        code_records = snapshot_code(study_root, run_dir, preset)
        params = load_params(args)
        (run_dir / "params.json").write_text(json.dumps(params, indent=2, sort_keys=True) + "\n", encoding="utf-8")

        from modules.data import load_study_measurements
        data = load_study_measurements(study_root, run_dir, project_root)
        scripts_dir = study_root / "scripts"
        if str(scripts_dir) not in sys.path:
            sys.path.insert(0, str(scripts_dir))
        specific_mod = importlib.import_module(f"specific.{args.specific}")
        analysis_fn = getattr(specific_mod, "run_study_analysis", None)
        if not callable(analysis_fn):
            raise ValueError(f"specific.{args.specific} does not expose run_study_analysis(data, params)")
        analyzed = analysis_fn(data, params)
        if not isinstance(analyzed, dict) or analyzed.get("status") != "SUCCESS":
            raise ValueError("Analysis did not return status SUCCESS")

        from modules.theme import load_study_colors
        palette_path = study_root / "color-code.yaml"
        palette = load_study_colors(study_root) if palette_path.is_file() else {}
        render_fn = getattr(specific_mod, "render_figures", None)
        if callable(render_fn):
            render_fn(analyzed, palette, run_dir, preset_path=preset, params=params)
        else:
            from modules.plot import plot_study_results
            plot_study_results(data=analyzed, palette=palette, run_dir=run_dir, preset_path=preset,
                               params=params, study_slug=study_root.name)

        outputs = output_inventory(run_dir)
        validate_required_outputs(run_dir, analyzed.get("required_outputs"), outputs)
        required_outputs_valid = True
        if not outputs:
            raise ValueError("Analysis produced no output files")
        input_unchanged = all(
            sha256_file(Path(item["path"]) if Path(item["path"]).is_absolute() else project_root / item["path"]) == item["sha256"]
            for record in data["inputs"] for item in record["files"]
        )
        if not input_unchanged:
            raise ValueError("Selected inputs changed during execution")
        protected_unchanged = tree_hashes(study_root) == before
        if not protected_unchanged:
            raise ValueError("Protected study files changed during execution")
        if not recovery_snapshots_unchanged(study_root, plan_record, input_record, code_records):
            raise ValueError("Recovery snapshots changed during execution")
        status, exit_code = "COMPLETED", 0
    except KeyboardInterrupt as exc:
        error = "Execution interrupted by KeyboardInterrupt"
        interrupt = exc
        status, exit_code = "FAILED", 1
    except SystemExit as exc:
        error = f"Analysis exited via SystemExit({exc.code})"
        status, exit_code = "FAILED", 1
    except Exception as exc:  # aqg: top-level boundary - retain execution failures in the immutable lock
        error = str(exc) or repr(exc)

    try:
        outputs = output_inventory(run_dir)
    except Exception as exc:  # aqg: top-level boundary - retain partial evidence when inventory fails
        error = error or str(exc)
        outputs = []
        status, exit_code = "FAILED", 1
    if status == "FAILED":
        try:
            input_unchanged = input_unchanged or (
                data is not None and all(
                    sha256_file(Path(item["path"]) if Path(item["path"]).is_absolute() else project_root / item["path"]) == item["sha256"]
                    for record in data.get("inputs", []) for item in record.get("files", [])
                )
            )
            protected_unchanged = tree_hashes(study_root) == before
        except Exception as check_exc:  # aqg: top-level boundary - record failed post-flight checks
            error = error or str(check_exc)

    question_path = study_root / "spec" / "reasoning.md"
    try:
        question = question_path.read_text(encoding="utf-8").strip() if question_path.is_file() else ""
    except UnicodeDecodeError as exc:
        question = ""
        error = error or f"spec/reasoning.md must be valid UTF-8: {exc}"
        status, exit_code = "FAILED", 1
    lock = {
        "schema_version": 1,
        "owner": "implement-research",
        "run_id": run_id,
        "status": status,
        "scientific_acceptance": "NOT_ASSESSED",
        "started_at": started_at,
        "finished_at": datetime.now(timezone.utc).isoformat(),
        "question": question,
        "plan": plan_record,
        "input_manifest": input_record,
        "inputs": data.get("inputs", []) if data else [],
        "parameters": params,
        "validation": {
            "inputs_unchanged": input_unchanged,
            "protected_files_unchanged": protected_unchanged,
            "required_outputs_valid": required_outputs_valid,
        },
        "code": {"files": code_records},
        "environment": environment_record(),
        "command": [sys.executable, str(Path(__file__).resolve()), *(argv or sys.argv[1:])],
        "exit_code": exit_code,
        "outputs": outputs,
    }
    if error:
        lock["error"] = error
    lock_path = run_dir / "run.lock.yaml"
    lock_path.write_text(yaml.safe_dump(lock, sort_keys=False, allow_unicode=True), encoding="utf-8")
    print(f"{status}: {run_dir}")
    if error:
        print(error, file=sys.stderr)
    if interrupt is not None:
        raise interrupt
    return exit_code


if __name__ == "__main__":
    argv = sys.argv[1:]
    raise SystemExit(main(argv))
